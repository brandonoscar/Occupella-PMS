# The keys a company brings to run the PMS (docs/install.md, "Keys you bring").
# Copy this file to .env, next to compose.selfhost.yaml, and fill it in. .env is ignored by git:
# never commit it, and keep a copy somewhere safe (a password manager), above all PMS_DATA_KEY.

# --- Needed --------------------------------------------------------------------------------

# The database's password. Letters and digits only (it goes in a URL): openssl rand -hex 24
PMS_DB_PASSWORD=

# The address people open the PMS at, with https:// and no slash at the end. Invite links,
# emails and the payments partner's return pages use it.
PMS_PUBLIC_URL=https://pms.example.com

# Seals owners' and vendors' bank account numbers and tax IDs: 32 random bytes in base64.
# Make it once (openssl rand -base64 32) and never change or lose it: what it sealed can't be
# read without it. Without it the PMS keeps no account numbers or tax IDs and says so.
PMS_DATA_KEY=

# --- Email (invites, password resets, receipts, notices) ------------------------------------

# "smtp" sends through your mail provider over STARTTLS; empty sends nothing and every email
# waits in the PMS (each person's Email tab).
PMS_EMAIL_SENDER=
PMS_SMTP_HOST=
PMS_SMTP_PORT=587
PMS_SMTP_USERNAME=
PMS_SMTP_PASSWORD=
PMS_EMAIL_FROM=

# --- Rent paid online (optional) -----------------------------------------------------------

# "stripe" lets tenants pay rent by bank, and owners pay in, through your company's own Stripe
# account; empty takes no payments online. Its webhook goes to
# $PMS_PUBLIC_URL/api/payments/webhook/stripe (docs/install.md, "Payments online").
PMS_PAYMENTS=
PMS_STRIPE_SECRET_KEY=
PMS_STRIPE_WEBHOOK_SECRET=

# --- Maps (optional) ------------------------------------------------------------------------

# "census" finds each property's place from its address with the U.S. Census Bureau's free
# geocoder (no key); empty finds none.
PMS_GEOCODER=

# --- Leave as they are unless you know why -------------------------------------------------

# The nightly run posts rent, recurring charges, late fees and recurring bills at start and
# every day at 06:00 UTC. "off" stops it (then an admin's Run rent now on the rent roll).
PMS_NIGHTLY=on
# The session cookie goes only over HTTPS. "false" only to try it without HTTPS on localhost.
PMS_COOKIE_SECURE=true
