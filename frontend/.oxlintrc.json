{
  // oxlint (MIT; `npm run lint`): every rule oxlint counts as correctness, with the React,
  // accessibility (jsx-a11y), vitest, TypeScript, unicorn and import plugins. The few turned
  // off say why.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y", "vitest", "unicorn", "oxc", "import"],
  "categories": { "correctness": "error" },
  "rules": {
    // The portal loads a page's data once, by its id, and again when asked ("Show",
    // after a save); the full dependency list would load it again on every keystroke.
    "react-hooks/exhaustive-deps": "off",
    // Rules for the React Compiler, which the portal doesn't use.
    "react/purity": "off",
    "react/set-state-in-effect": "off",
    // A mocked fetch takes its types from where it is used.
    "vitest/require-mock-type-parameters": "off",
    // A dialog moves focus into itself (WAI-ARIA's dialog pattern): Confirm's answer button.
    "jsx-a11y/no-autofocus": "off",
    // role="status" and role="group" on a div are ARIA's own patterns for a live message and
    // a set of fields; <output> and <fieldset> mean something else and lay out differently.
    "jsx-a11y/prefer-tag-over-role": "off",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    // Testing Library's findBy* fails the test when what it looks for never shows.
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "screen.findBy*"] }],
    // fast-check's test.prop is a test (properties.test.ts).
    "vitest/no-standalone-expect": ["error", { "additionalTestBlockFunctions": ["test.prop"] }]
  }
}
